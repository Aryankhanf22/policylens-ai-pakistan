rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidSimulation(data) {
      return data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.petrolPrice is number
        && data.dieselPrice is number
        && data.highOctanePrice is number
        && data.taxRateChange is number
        && data.subsidyChange is number
        && data.createdAt is timestamp;
    }

    function isValidBusinessLog(data) {
      return data.userId == request.auth.uid
        && data.businessType is string
        && data.dailyFuelUsage is number
        && data.oldPrice is number
        && data.newPrice is number
        && data.createdAt is timestamp;
    }

    function isValidHabitLog(data) {
      return data.userId == request.auth.uid
        && data.fuelType is string
        && data.amountPKR is number
        && data.createdAt is timestamp;
    }

    // 1. Simulations
    match /simulations/{simulationId} {
      allow read: if isOwner(existing());
      allow create: if isSignedIn() && isValidId(simulationId) && isValidSimulation(incoming());
      allow update: if isOwner(existing()) && isValidSimulation(incoming()) 
        && incoming().userId == existing().userId;
      allow delete: if isOwner(existing());
    }

    // 2. Business Logs
    match /businessLogs/{logId} {
      allow read: if isOwner(existing());
      allow create: if isSignedIn() && isValidId(logId) && isValidBusinessLog(incoming());
      allow delete: if isOwner(existing());
    }

    // 3. Habit Logs
    match /habitLogs/{habitId} {
      allow read: if isOwner(existing());
      allow create: if isSignedIn() && isValidId(habitId) && isValidHabitLog(incoming());
      allow delete: if isOwner(existing());
    }
  }
}
